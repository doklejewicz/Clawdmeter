# PlatformIO build artifacts
firmware/.pio/
firmware/.vscode/

# Self-extracting setup bundle — generated by tools/build_setup_bundle.sh,
# flashed to SPIFFS via `pio run -t uploadfs`, not source
firmware/data/setup.sh

# Downloaded/captured by tools/get_setup.sh's `get-setup` serial command
# when run from the repo root instead of a scratch dir
/setup.sh
/raw.bin

# OS
.DS_Store

# Claude Code
.claude/

# Node tooling deps (npm install --no-save)
tools/node_modules/
tools/package-lock.json

# Mac daemon venv
daemon/.venv/

# Python bytecode cache
__pycache__/
*.pyc
